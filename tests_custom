#!/bin/sh
# Entry point sourced by Lynis from its include directory.
# These files must be installed together in the SAME Lynis include directory.
# The actual tests (and Register/Display/LogText/Report/AddHP calls) live in:
#   tests_filevault_macos  -> CUST-9001
#   tests_ipv6_macos       -> CUST-9002
#   tests_firewall_macos   -> CUST-9003
# Do not execute this file directly or call exit from a sourced Lynis test.

if [ -z "${INCLUDEDIR:-}" ]; then
    LogText "Custom macOS audit: Lynis INCLUDEDIR is not set; no tests loaded"
    ReportWarning "NONE" "Unable to load macOS custom tests: Lynis include path missing"
else
    for CUST_TEST_FILE in tests_filevault_macos tests_ipv6_macos tests_firewall_macos; do
        CUST_TEST_PATH="${INCLUDEDIR}/${CUST_TEST_FILE}"
        if [ -r "${CUST_TEST_PATH}" ]; then
            . "${CUST_TEST_PATH}"
        else
            LogText "Custom macOS audit: missing/unreadable ${CUST_TEST_PATH}"
            ReportWarning "NONE" "Missing custom macOS audit file: ${CUST_TEST_FILE}"
            Display --indent 2 --text "- ${CUST_TEST_FILE}" --result "NOT LOADED" --color YELLOW
        fi
    done
fi
