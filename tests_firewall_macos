#!/bin/sh
# Optional extended macOS firewall audit, intended as an ALTERNATIVE to the
# FIRE-9001 block in tests_custom. Do not source both: IDs must remain unique.
# This file is sourced by Lynis, not executed as a standalone shell program.

Register --test-no FIRE-9001 --os macOS --weight L --network NO --category security \
    --description "Audit macOS Application Firewall, stealth mode, and diagnostics"
if [ "${SKIPTEST:-1}" -eq 0 ]; then
    InsertSection "macOS Application Firewall - Extended Audit"
    FIREWALL_BIN="${FIREWALL_BIN:-/usr/libexec/ApplicationFirewall/socketfilterfw}"

    # 1. Application Firewall global state
    LogText "FIRE-9001: Checking macOS Application Firewall state"
    if [ -x "${FIREWALL_BIN}" ]; then
        FW_STATUS=$("${FIREWALL_BIN}" --getglobalstate 2>/dev/null)
        case "${FW_STATUS}" in
            *"Firewall is enabled"*|*"Firewall is Enabled"*)
                Display --indent 2 --text "- macOS Application Firewall" --result "ENABLED" --color GREEN
                Report "firewall_status=enabled"
                LogText "FIRE-9001: Application Firewall enabled"
                AddHP 5 5
                ;;
            *"Firewall is disabled"*|*"Firewall is Disabled"*)
                Display --indent 2 --text "- macOS Application Firewall" --result "DISABLED" --color RED
                Report "firewall_status=disabled"
                ReportWarning "${TEST_NO}" "Application Firewall is disabled"
                LogText "FIRE-9001: Application Firewall disabled"
                AddHP 0 5
                ;;
            *)
                Display --indent 2 --text "- macOS Application Firewall" --result "UNVERIFIED" --color YELLOW
                Report "firewall_status=unknown"
                LogText "FIRE-9001: Application Firewall state unavailable"
                ;;
        esac

        # 2. Application Firewall stealth mode
        STEALTH_STATUS=$("${FIREWALL_BIN}" --getstealthmode 2>/dev/null)
        case "${STEALTH_STATUS}" in
            *"Stealth mode enabled"*|*"Stealth mode is on"*)
                Display --indent 2 --text "- Firewall stealth mode" --result "ENABLED" --color GREEN
                Report "firewall_stealth_mode=enabled"
                LogText "FIRE-9001: Stealth mode enabled"
                AddHP 5 5
                ;;
            *"Stealth mode disabled"*|*"Stealth mode is off"*)
                Display --indent 2 --text "- Firewall stealth mode" --result "DISABLED" --color YELLOW
                Report "firewall_stealth_mode=disabled"
                ReportSuggestion "${TEST_NO}" "Consider enabling Application Firewall stealth mode"
                LogText "FIRE-9001: Stealth mode disabled"
                AddHP 0 5
                ;;
            *)
                Display --indent 2 --text "- Firewall stealth mode" --result "UNVERIFIED" --color YELLOW
                Report "firewall_stealth_mode=unknown"
                LogText "FIRE-9001: Stealth mode state unavailable"
                ;;
        esac

        # 3. Optional list of application-specific firewall rules (no fake counts)
        APP_RULES=$("${FIREWALL_BIN}" --listapps 2>/dev/null)
        if [ -n "${APP_RULES}" ]; then
            Display --indent 2 --text "- Application firewall rules" --result "AVAILABLE" --color WHITE
            Report "firewall_app_rules=available"
            LogText "FIRE-9001: Application firewall rules are available for review"
        else
            Display --indent 2 --text "- Application firewall rules" --result "UNAVAILABLE" --color YELLOW
            Report "firewall_app_rules=unknown"
        fi
    else
        Display --indent 2 --text "- macOS Application Firewall" --result "UNVERIFIED" --color YELLOW
        LogText "FIRE-9001: socketfilterfw unavailable"
        Report "firewall_status=unknown"
        Report "firewall_stealth_mode=unknown"
        Report "firewall_app_rules=unknown"
    fi

    # 4. Separate packet filter diagnostic; pf is NOT the Application Firewall.
    if [ -x /sbin/pfctl ]; then
        PF_STATUS=$(/sbin/pfctl -s info 2>/dev/null)
        case "${PF_STATUS}" in
            *"Status: Enabled"*)
                Display --indent 2 --text "- Packet filter (pf; separate)" --result "ENABLED" --color GREEN
                Report "firewall_pf_daemon=running"
                LogText "FIRE-9001: Separate pf packet filter enabled"
                ;;
            *"Status: Disabled"*)
                Display --indent 2 --text "- Packet filter (pf; separate)" --result "DISABLED" --color WHITE
                Report "firewall_pf_daemon=inactive"
                LogText "FIRE-9001: Separate pf packet filter disabled"
                ;;
            *)
                Display --indent 2 --text "- Packet filter (pf; separate)" --result "UNVERIFIED" --color WHITE
                Report "firewall_pf_daemon=unknown"
                ;;
        esac
    else
        Report "firewall_pf_daemon=unknown"
        LogText "FIRE-9001: pfctl unavailable"
    fi

    LogText "FIRE-9001: Extended macOS firewall audit complete"
fi
